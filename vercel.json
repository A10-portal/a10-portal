{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/api/get-user?action=contact"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/8012limpjes45mn2",
      "destination": "/8012limpjes45mn2.html"
    },
    {
      "source": "/success",
      "destination": "/success.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    }
  ]
}